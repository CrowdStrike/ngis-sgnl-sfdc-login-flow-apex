<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <applicationVisibilities>
        <application>Login_Flow_Admin_App</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>LoginFlowAdminController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LoginFlowConfig</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SgnlClient</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <description>Grants the Continuous Identity Admin app and tab (read-only config view and Test Connection). Editing the configuration is done in Setup under Custom Metadata Types and requires Customize Application, which this permission set does not grant.</description>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>NGIS_SGNL_Falcon_OAuth-NGIS_SGNL_Principal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
    <hasActivationRequired>false</hasActivationRequired>
    <label>NGIS SGNL Login Flow Admin</label>
    <license>Salesforce</license>
    <tabSettings>
        <tab>Login_Flow_Admin</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
